# ── Site ──────────────────────────────────────────────────────────────
# Your live domain, no trailing slash (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://www.rahuldevbanjara.com.np

# 48+ random characters. Generate with:  openssl rand -base64 48
AUTH_SECRET=

# Admin login email (password is set with `npm run admin:password`)
ADMIN_EMAIL=rdbanjara07@gmail.com

# ── AI ────────────────────────────────────────────────────────────────
# Public assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Backup model when Gemini is busy (https://console.groq.com/keys) — optional
GROQ_API_KEY=
# Private admin assistant — a separate key so it has its own quota
ADMIN_GEMINI_API_KEY=
# Optional overrides (comma-separated, tried in order)
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite
# ADMIN_GEMINI_MODELS=gemini-2.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite

# ── Database (Turso) ──────────────────────────────────────────────────
# Leave empty in development to use data/site.db on disk.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Images (Vercel Blob) ──────────────────────────────────────────────
# Added automatically when you connect a Blob store in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
