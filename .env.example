# ---------------------------------------------------------------------------
# Portfolio environment template
#
# Copy to .env.local and fill in.  .env.local is gitignored; never commit real
# values.  Anything prefixed NEXT_PUBLIC_ is bundled into client JavaScript and
# is PUBLIC — never put a secret behind that prefix.
# ---------------------------------------------------------------------------


# --- Site -------------------------------------------------------------------

# Canonical production origin, no trailing slash.  Used for canonical URLs,
# sitemap, RSS, and absolute OG image URLs.  Set to the Vercel preview origin
# while previewing so metadata stays self-consistent.
NEXT_PUBLIC_SITE_URL="https://rahuldevbanjara.com.np"


# --- Hashnode (blog content backend) ----------------------------------------
# Requires an active Hashnode Pro plan.  The GraphQL API is paywalled; without
# it the publication query returns FORBIDDEN and /blog cannot render.
# Reference: .agents/skills/gql-api

# Your publication's host as Hashnode knows it.  This is the lookup key for the
# publication query — it stays the Hashnode host even when the blog is served
# from your own domain.  Find it in Hashnode dashboard → Publication settings.
HASHNODE_PUBLICATION_HOST="yourname.hashnode.dev"

# GraphQL endpoint.  Current endpoint as of 2026-08-23; gql.hashnode.com
# 301-redirects here.  Override only if Hashnode moves it again.
HASHNODE_API_ENDPOINT="https://gql-beta.hashnode.com/"

# Personal Access Token.  SERVER-ONLY — this grants full write access to your
# publications.  It must never be exposed to the browser, committed, or given
# a NEXT_PUBLIC_ prefix.  Only needed for drafts, scheduled posts, preview
# mode, and publishing; public post reads work unauthenticated.
# Generate at: Hashnode dashboard → Settings → Developer → Personal Access Tokens
HASHNODE_ACCESS_TOKEN=""


# --- Revalidation webhook ---------------------------------------------------

# Shared secret for the /api/revalidate route that Hashnode webhooks call when
# a post is published, updated, or deleted.  Generate with:
#   openssl rand -hex 32
# Configure the same value in Hashnode dashboard → Settings → Webhooks.
REVALIDATE_SECRET=""


# --- Giscus (comments + reactions) ------------------------------------------
# GitHub Discussions as the comment backend.  Hashnode's API cannot accept
# comments or reactions from a custom frontend, so this is where discussion
# lives.  All values here are public by design.
#
# Generate these at https://giscus.app after:
#   1. making the target repo public
#   2. installing the Giscus GitHub App on it
#   3. enabling the Discussions feature
#   4. creating a Discussions category (recommended: "Blog", Announcements type)

NEXT_PUBLIC_GISCUS_REPO="devrahulbanjara/portfolio-website"
NEXT_PUBLIC_GISCUS_REPO_ID=""
NEXT_PUBLIC_GISCUS_CATEGORY="Blog"
NEXT_PUBLIC_GISCUS_CATEGORY_ID=""

# How a page maps to its discussion thread. "pathname" keeps threads stable
# across title edits; avoid "title" for that reason.
NEXT_PUBLIC_GISCUS_MAPPING="pathname"


# --- Analytics --------------------------------------------------------------

# Vercel Analytics needs no environment variables — it is enabled in the Vercel
# dashboard and read via @vercel/analytics.  Nothing to set here.

# PostHog is optional and deferred; leave blank unless it is actually adopted.
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
